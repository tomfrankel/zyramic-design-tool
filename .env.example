# Zyramic Proposal Software — draft environment
# Copy to .env for local server use. NEVER commit a real .env.

PORT=8787

# Demo session keys (not production secrets). Used only for the draft role wall.
DEMO_CUSTOMER_KEY=customer
DEMO_SALES_KEY=sales
DEMO_ENGINEERING_KEY=engineering
DEMO_ADMIN_KEY=admin

# Persistence
DATA_DIR=./data

# Optional Chinese OEM estimate stub for Swing only.
# Leave blank to keep the line item flagged UNKNOWN.
# This is an engineering/sales screening stub — not a customer quote and not a US fab price.
SWING_OEM_ESTIMATE_USD_PER_M2=

# Dropbox adapter stub (do not put real tokens in git)
DROPBOX_ENABLED=false
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT=/Zyramic Setup Info/Proposal Software/Orders

# HubSpot adapter stub
HUBSPOT_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_DEAL_ATTACHMENT_STUB=true
